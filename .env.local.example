# ── Supabase ──────────────────────────────────────────────────────────
# Copy this file to `.env.local` and paste your keys in.
# Find both values in your Supabase project:
#   Dashboard → Project Settings → API
#
# Project URL  (looks like https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key  (the long "anon public" key — safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
